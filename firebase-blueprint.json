{
  "entities": {
    "User": {
      "title": "User",
      "description": "User trading profile, settings, balance, and synchronized app state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "startingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "dailyProfitTarget": { "type": "number" },
        "targetDays": { "type": "number" },
        "isSetupComplete": { "type": "boolean" },
        "appState": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user document containing trader credentials, balance and journal sync"
    }
  }
}
