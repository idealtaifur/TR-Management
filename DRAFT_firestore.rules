rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return incoming().updatedAt == request.time &&
             incoming().uid == existing().uid &&
             incoming().createdAt == existing().createdAt;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUserUpdate(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'avatar', 'gender', 'age', 'address', 'experienceMonths', 'experienceYears', 'timezone', 'startingBalance', 'dailyProfitTarget', 'targetDays', 'preferredStrategy', 'isSetupComplete', 'balance', 'updatedAt'])
      );
    }
  }
}
